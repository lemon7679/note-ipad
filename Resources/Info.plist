<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged by xtool over its generated Info.plist (xtool.yml → infoPath). -->
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Note</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>ko</string>

    <!-- iPad only, every orientation, Split View / Stage Manager. -->
    <key>UIDeviceFamily</key>
    <array>
        <integer>2</integer>
    </array>
    <key>UIRequiresFullScreen</key>
    <false/>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>

    <!-- "이 iPad" library is visible in the Files app; PDFs and notebooks open in place. -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Note Notebook</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.lemon7679.note.inknote</string>
            </array>
            <key>LSTypeIsPackage</key>
            <true/>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>PDF</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.adobe.pdf</string>
            </array>
        </dict>
    </array>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.lemon7679.note.inknote</string>
            <key>UTTypeDescription</key>
            <string>Note Notebook</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>com.apple.package</string>
                <string>public.composite-content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>inknote</string>
                </array>
            </dict>
        </dict>
    </array>

    <!-- NAS on the local network: Bonjour discovery and LAN connections. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>같은 네트워크에 있는 NAS를 찾고 노트를 동기화하는 데 사용합니다.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_smb._tcp</string>
        <string>_afpovertcp._tcp</string>
        <string>_webdav._tcp</string>
        <string>_webdavs._tcp</string>
    </array>
    <!-- Home NAS boxes are often reached over plain HTTP on the LAN or a DDNS name.
         HTTPS is the default in the app; HTTP is only used when the user turns it off. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>

    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
